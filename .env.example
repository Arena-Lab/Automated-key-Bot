# Telegram Bot Configuration
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_IDS=123456789

# Payment Configuration
PAYMENT_MODE=manual
UPI_ID=your_upi@fam
PAYEE_NAME=Your Business Name
PAYMENT_VALIDITY_MINUTES=10
PAYMENT_INSTRUCTIONS=Pay via UPI and submit the UTR or screenshot for verification.
PAYMENT_VERIFICATION_GROUP_ID=-100xxxxxxxxxx

# Automatic payment verification (Gmail IMAP - used when PAYMENT_MODE=automatic
# or the admin toggles Payment Mode -> Automatic in /settings)
# Gmail address that receives FamApp/bank UPI credit-alert emails
IMAP_USERNAME=your@gmail.com
# Gmail App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
IMAP_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional overrides (defaults shown)
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_MAILBOX=INBOX
# Only match credit alerts from this sender (FamApp default; set your bank's
# alert sender if payments land in a different mailbox format)
IMAP_SENDER_FILTER=no-reply@famapp.in
# UPI ID embedded in the per-order payment QR/URI (falls back to UPI_ID above
# if left empty, but auto-verify stays disabled until this is set)
DEFAULT_UPI_ID=your_upi@fam
PAYEE_NAME=Your Business Name
# Purpose-note prefix for per-order payment references (e.g. KS-20261113-AB12CD)
PURPOSE_PREFIX=KS
# Minutes a verify order stays matchable / payment stays payable in auto mode
PAYMENT_EXPIRY_MINUTES=30
# Seconds between Gmail mailbox scans
PAYVERIFY_POLL_SECONDS=25
# GMAIL_LOOKBACK_HOURS=12

# Shop Configuration
SHOP_NAME=Key Shop
SHOP_USERNAME=@keyshop
OFFICIAL_CHANNEL=@your_channel
SUPPORT_USERNAME=@your_support

# Bot Settings
MAINTENANCE_MODE=false
BROADCAST_CHUNK_SIZE=50
BROADCAST_DELAY_SECONDS=1

# Reseller Configuration
RESELLER_SYSTEM_ENABLED=false
